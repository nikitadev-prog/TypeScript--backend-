generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  description String
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  email       String?
  phone       String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills     Skill[]
  experience Experience[]
  projects   Project[]
}

model Skill {
  id        String  @id @default(cuid())
  name      String
  category  String?
  sortOrder Int     @default(0)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
}

model Experience {
  id           String    @id @default(cuid())
  company      String
  companyUrl   String?
  position     String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  achievements String[]
  sortOrder    Int       @default(0)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  url         String?
  repoUrl     String?
  sortOrder   Int     @default(0)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
